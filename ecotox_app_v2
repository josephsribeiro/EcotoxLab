            d3.metric("z-value (slope)", str(res["z_value"]) if res["z_value"] else "—")
            d4.metric("Var(log CL)",    f"{res['variance']:.6f}" if res["variance"] else "—")

        st.markdown("---")
        e1, e2 = st.columns(2)
